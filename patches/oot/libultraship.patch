diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 45989b6..31e3e74 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -10,6 +10,19 @@ set_target_properties(libultraship PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS TRUE)
 find_package(Python3 REQUIRED COMPONENTS Interpreter)
 
 set(INCLUDE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/../include)
+
+# The Apple Watch port's backends (Retro Apple Watch, port/oot): their sources
+# and include directories, compiled with libultraship's own flags.
+set(LUS_WATCH_PORT_SOURCES "" CACHE STRING "Watch port sources built into libultraship")
+set(LUS_WATCH_PORT_INCLUDES "" CACHE STRING "Include directories of the watch port sources")
+if(LUS_WATCH_PORT_SOURCES)
+    target_sources(libultraship PRIVATE ${LUS_WATCH_PORT_SOURCES})
+    target_include_directories(libultraship PRIVATE ${LUS_WATCH_PORT_INCLUDES})
+    target_compile_definitions(libultraship PRIVATE LUS_WATCH_PORT)
+    # The software renderer is the hot spot, and drawing does not need the
+    # strict floating point the game's own code is built with.
+    set_source_files_properties(${LUS_WATCH_PORT_SOURCES} PROPERTIES COMPILE_OPTIONS "-O3;-ffp-contract=fast")
+endif()
 option(USE_OPENGLES "Enable GLES3" OFF)
 option(GFX_DEBUG_DISASSEMBLER "Enable libgfxd" OFF)
 
@@ -55,7 +68,7 @@ add_subdirectory("libultraship")
 
 add_subdirectory("ship")
 
-if (CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
+if (CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_SYSTEM_NAME STREQUAL "iOS" OR CMAKE_SYSTEM_NAME STREQUAL "watchOS")
     set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/ship/utils/AppleFolderManager.mm PROPERTIES COMPILE_FLAGS -fno-objc-arc)
 endif()
 
@@ -201,6 +214,14 @@ if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
             XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED "NO"
         )
     endif()
+elseif (CMAKE_SYSTEM_NAME STREQUAL "watchOS")
+    target_compile_definitions(libultraship PUBLIC __WATCHOS__)
+    target_compile_definitions(libultraship PRIVATE
+        $<$<CONFIG:Debug>:_DEBUG>
+        $<$<NOT:$<CONFIG:Debug>>:NDEBUG>
+        SPDLOG_ACTIVE_LEVEL=${SPDLOG_MIN_CUTOFF}
+        $<$<BOOL:${GFX_DEBUG_DISASSEMBLER}>:GFX_DEBUG_DISASSEMBLER>
+    )
 else()
     target_compile_definitions(libultraship PRIVATE
         ENABLE_OPENGL
